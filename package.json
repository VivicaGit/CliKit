{
  "name": "clikit",
  "version": "1.0.0",
  "description": "CliKit by vivica",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.vivica.clikit",
    "productName": "CliKit",
    "asarUnpack": [
      "functions.ps1"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "functions.ps1",
      "LICENSE.txt",
      "icon.ico"
    ]
  },
  "keywords": [],
  "author": "vivica",
  "license": "SEE LICENSE IN LICENSE.txt",
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3"
  }
}
